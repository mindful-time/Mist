{
  "name": "Main maintainer merges only",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    { "actor_id": 167177011, "actor_type": "User", "bypass_mode": "pull_request" }
  ],
  "conditions": {
    "ref_name": { "include": ["refs/heads/main"], "exclude": [] }
  },
  "rules": [
    { "type": "update", "parameters": { "update_allows_fetch_and_merge": false } }
  ]
}
